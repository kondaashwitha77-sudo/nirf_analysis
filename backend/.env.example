# Copy to .env and adjust. Never commit the real .env file.
APP_NAME="NIRF Insights API"
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api

# SQLite for local development (path is relative to the folder you run the server from).
DATABASE_URL=sqlite:///./nirf_insights.db
# PostgreSQL later (install a driver first, e.g. pip install "psycopg[binary]"):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/nirf_insights

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI Analyst (optional) ---------------------------------------------------
# Put your AI provider key here. It stays on the server and is never sent to the browser.
# Works with any OpenAI-compatible API. Defaults are for xAI (Grok).
AI_API_KEY=
AI_BASE_URL=https://api.x.ai/v1
AI_MODEL=grok-4

LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
